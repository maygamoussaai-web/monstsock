# Copiez ce fichier en .env et remplissez vos propres valeurs.
# Ne commitez JAMAIS le fichier .env — il est dans .gitignore.

# Identifiant du projet Supabase (visible dans Settings > General)
SUPABASE_PROJECT_ID="votre-project-id"

# Clé anon publique Supabase (Settings > API > Project API keys)
SUPABASE_PUBLISHABLE_KEY="votre-cle-anon"

# URL du projet Supabase
SUPABASE_URL="https://votre-project-id.supabase.co"

# Variables VITE_ exposées au frontend
VITE_SUPABASE_PROJECT_ID="votre-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="votre-cle-anon"
VITE_SUPABASE_URL="https://votre-project-id.supabase.co"
